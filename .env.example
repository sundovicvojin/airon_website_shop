# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public URL, for example https://airon.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Future payment adapter
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Contact inquiries (see docs/INQUIRIES.md)
# Cloudflare Turnstile. The site key is public; the secret is server-only.
# In production the secret is required: submissions are rejected without it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Random 32+ character string used to hash IP addresses for rate limiting. Required in production.
IP_HASH_SALT=
# Resend notification email. Without RESEND_API_KEY inquiries are still saved and a warning is logged.
RESEND_API_KEY=
INQUIRY_NOTIFY_EMAIL=
INQUIRY_FROM_EMAIL=

# Future transactional email adapter
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# Future analytics integrations
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
